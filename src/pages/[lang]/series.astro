---
import Shell from "../../components/FeatureShell.astro";
import { getLocaleStaticPaths } from "../../config/paths";
import { getCollection } from "astro:content";
import { isPublished } from "../../utils/blog";
import { getReadingPaths } from "../../data/series";
import { featureCopy } from "../../i18n/features";
export const getStaticPaths = getLocaleStaticPaths;
const { lang } = Astro.locals;
const c = featureCopy(lang);
const paths = getReadingPaths(lang);
const posts = await getCollection(
  "blog",
  ({ data }) => data.lang === lang && isPublished(data),
);
---

<Shell
  title={c.series}
  description={c.seriesDescription}
  structuredDataType="collection"
>
  {paths.map((path) => (
    <section
      id={path.id}
      data-spotlight="true"
      class="card bg-base-200/90 md:bg-base-200/55 md:backdrop-blur-md border border-base-content/10 hover:border-primary/40 transition-all duration-300 p-6 space-y-4 scroll-mt-24 rounded-2xl"
    >
      <h2 class="text-sm md:text-base font-bold">{path.title}</h2>
      <p class="text-xs md:text-sm leading-relaxed opacity-85">
        {path.description}
      </p>
      <p class="text-xs md:text-sm leading-relaxed">
        <strong>{c.prerequisites}: </strong>
        <span class="opacity-85">{path.prerequisites}</span>
      </p>
      <ol class="list-decimal pl-5 space-y-2 text-xs md:text-sm">
        {path.slugs
          .map((slug) => posts.find((p) => p.data.slug === slug))
          .filter((p) => p !== undefined)
          .map((post) => (
            <li>
              <a
                class="font-medium hover:text-primary transition-colors"
                href={`/${lang}/blog/${post.data.slug}/`}
              >
                {post.data.title}
              </a>{" "}
              <span
                class="series-completion badge badge-xs badge-success hidden"
                data-url={`/${lang}/blog/${post.data.slug}/`}
              >
                {c.complete}
              </span>
            </li>
          ))}
      </ol>
    </section>
  ))}
</Shell>
<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";
  import { readingEntries } from "../../utils/reader";
  onPageLoad(() => {
    const done = new Set(
      readingEntries()
        .filter((e) => e.completed || e.progress >= 0.98)
        .map((e) => e.url),
    );
    document
      .querySelectorAll<HTMLElement>(".series-completion")
      .forEach((el) =>
        el.classList.toggle("hidden", !done.has(el.dataset.url!)),
      );
  });
</script>
