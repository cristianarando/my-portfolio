---
import { getCollection } from "astro:content";
import { readingPaths } from "../../data/series";
import { isPublished } from "../../utils/blog";
import { featureCopy } from "../../i18n/features";
const { slug } = Astro.props;
const { lang } = Astro.locals;
const c = featureCopy(lang);
const path = readingPaths.find((p) =>
  (p.slugs as readonly string[]).includes(slug),
);
const posts = await getCollection(
  "blog",
  ({ data }) => data.lang === lang && isPublished(data),
);
const ordered =
  path?.slugs
    .map((s) => posts.find((p) => p.data.slug === s))
    .filter((p) => p !== undefined) || [];
const index = ordered.findIndex((p) => p.data.slug === slug);
---

{path && (
  <section
    class="my-8 rounded-2xl bg-base-200/80 border border-base-content/10 p-4 md:p-5 space-y-2.5"
    aria-label={c.series}
  >
    <a
      class="inline-block font-mono text-xs font-semibold uppercase tracking-wider text-primary hover:underline"
      href={`/${lang}/series/#${path.id}`}
    >
      {c.series} · {index + 1}/{ordered.length}
    </a>
    <div class="flex flex-wrap justify-between gap-3 text-xs md:text-sm">
      {ordered[index - 1] && (
        <a
          class="font-medium text-base-content/85 hover:text-primary transition-colors"
          href={`/${lang}/blog/${ordered[index - 1].data.slug}/`}
        >
          ← {c.previous}: {ordered[index - 1].data.title}
        </a>
      )}
      {ordered[index + 1] && (
        <a
          class="font-medium text-base-content/85 hover:text-primary transition-colors"
          href={`/${lang}/blog/${ordered[index + 1].data.slug}/`}
        >
          {c.next}: {ordered[index + 1].data.title} →
        </a>
      )}
    </div>
  </section>
)}
