---
import type { ProjectArchitectureFlow } from "../../data/architecture-flows";
import { featureCopy } from "../../i18n/features";
import type { Lang } from "../../i18n/utils";

interface Props {
  flow: ProjectArchitectureFlow;
  lang: Lang;
}

const { flow, lang } = Astro.props;
const c = featureCopy(lang);
const firstScenario = flow.scenarios[0];
const initialNodes = firstScenario.nodes;
const initialNode = initialNodes[0];
const titleId = `arch-flow-title-${flow.projectId}`;
---

<section
  class="arch-flow not-prose relative overflow-hidden rounded-2xl border border-base-content/15 bg-base-200/55 backdrop-blur-sm p-5 md:p-6 my-8 space-y-5 shadow-sm"
  aria-labelledby={titleId}
  data-flow={JSON.stringify(flow.scenarios)}
  data-play-label={c.archFlowPlay}
  data-pause-label={c.archFlowPause}
>
  <!-- Top Header + Controls -->
  <div class="flex flex-col gap-4 border-b border-base-content/10 pb-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="space-y-1 max-w-xl">
        <div class="flex items-center gap-2">
          <span
            class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse"
            aria-hidden="true"
          ></span>
          <h3
            id={titleId}
            class="text-base md:text-lg font-bold tracking-tight text-base-content"
          >
            {c.archFlowTitle}
          </h3>
        </div>
      </div>

      <!-- Playback & Stepper Toolbar -->
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button
          type="button"
          class="btn btn-outline btn-xs md:btn-sm gap-1.5 font-mono"
          data-arch-play
          aria-pressed="false"
        >
          <span aria-hidden="true">▶</span>
          <span data-arch-play-text>{c.archFlowPlay}</span>
        </button>
        <button
          type="button"
          class="btn btn-primary btn-xs md:btn-sm font-mono"
          data-arch-next
        >
          {c.archFlowStep} →
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-xs md:btn-sm font-mono border border-base-content/10"
          data-arch-reset
        >
          {c.archFlowReset}
        </button>
      </div>
    </div>

    <!-- Scenario Switcher + Scenario Metadata -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div
        class="flex flex-wrap items-center gap-2"
        role="group"
        aria-label={c.archFlowScenarioLabel}
      >
        <span class="text-[11px] font-mono uppercase tracking-wider text-base-content/55 mr-1">
          {c.archFlowScenarioLabel}:
        </span>
        {flow.scenarios.map((scenario, idx) => (
          <button
            type="button"
            data-arch-scenario
            data-scenario-index={idx}
            aria-pressed={idx === 0 ? "true" : "false"}
            class:list={[
              "px-3 py-1 rounded-full text-xs font-medium border transition-colors cursor-pointer",
              idx === 0
                ? "bg-primary text-primary-content border-primary shadow-sm"
                : "bg-base-100/70 text-base-content/80 border-base-content/15 hover:border-primary/40",
            ]}
          >
            {scenario.label}
          </button>
        ))}
      </div>

      <span
        data-arch-scenario-badge
        class="badge badge-outline badge-sm font-mono text-[11px] border-primary/40 text-primary"
      >
        {firstScenario.badge}
      </span>
    </div>

    <p
      data-arch-scenario-desc
      class="text-xs md:text-sm text-base-content/80 border-l-2 border-primary/50 pl-3"
    >
      {firstScenario.description}
    </p>
  </div>

  <!-- Desktop SVG Conduit & Animated Packet Track -->
  <div class="hidden lg:block relative h-5 px-2 select-none" aria-hidden="true">
    <svg
      class="w-full h-full overflow-visible"
      viewBox="0 0 100 12"
      preserveAspectRatio="none"
    >
      <line
        x1="12.5"
        y1="6"
        x2="87.5"
        y2="6"
        stroke="currentColor"
        stroke-opacity="0.18"
        stroke-width="1"
        stroke-dasharray="2 2"
        class="arch-conduit-dash"
      ></line>
    </svg>
    <!-- Active Signal Progress Track (aligned cleanly between 12.5% and 87.5%) -->
    <div class="absolute top-1/2 -translate-y-1/2 left-[12.5%] right-[12.5%] h-[2px] bg-base-content/10 pointer-events-none">
      <div
        data-arch-progress-bar
        class="h-full bg-primary transition-[width] duration-300 ease-out"
        style="width: 0%"
      ></div>
    </div>
    <!-- Moving Trace Pulse Node -->
    <span
      data-arch-packet
      class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-primary ring-4 ring-primary/20 shadow-sm transition-[left] duration-300 ease-out"
      style="left: 12.5%"
    ></span>
  </div>

  <!-- Pipeline Nodes Grid -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 relative"
    role="list"
  >
    {initialNodes.map((node, i) => (
      <button
        type="button"
        role="listitem"
        data-arch-node
        data-node-index={i}
        data-state={i === 0 ? "active" : "idle"}
        aria-current={i === 0 ? "step" : "false"}
        class:list={[
          "group relative flex flex-col items-start text-left rounded-xl border p-3.5 transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-primary",
          i === 0
            ? "border-primary bg-primary/10 shadow-md"
            : "border-base-content/12 bg-base-100/50 hover:border-primary/40 hover:bg-base-100/80",
        ]}
      >
        <div class="flex items-center justify-between w-full gap-2 mb-2">
          <span
            data-node-step
            class:list={[
              "inline-flex items-center justify-center w-6 h-6 rounded-md font-mono text-[11px] font-bold transition-colors",
              i === 0
                ? "bg-primary text-primary-content"
                : "bg-base-300 text-base-content/80",
            ]}
          >
            0{i + 1}
          </span>
          <span
            data-node-telemetry
            class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-base-200/80 border border-base-content/10 text-base-content/75 truncate max-w-[68%]"
          >
            {node.telemetry}
          </span>
        </div>

        <span
          data-node-layer
          class="text-[10px] font-mono uppercase tracking-wider text-primary/80 mb-0.5"
        >
          {node.layer}
        </span>
        <span
          data-node-title
          class="text-sm font-bold text-base-content leading-snug mb-1"
        >
          {node.title}
        </span>
        <span data-node-tech class="text-[11px] font-mono text-base-content/65">
          {node.tech}
        </span>

        {i < initialNodes.length - 1 && (
          <span
            data-arch-connector
            data-connector-index={i}
            aria-hidden="true"
            class="hidden lg:flex items-center justify-center absolute -right-2.5 top-1/2 -translate-y-1/2 z-10 w-5 h-5 rounded-full bg-base-100 border border-base-content/15 text-[10px] font-mono opacity-35 transition-all"
          >
            →
          </span>
        )}
      </button>
    ))}
  </div>

  <!-- Live Boundary Inspector Card -->
  <div
    data-arch-inspector
    role="region"
    aria-live="polite"
    class="rounded-xl border border-base-content/15 bg-base-100/85 p-4 md:p-5 space-y-4"
  >
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <span
          data-arch-step-pill
          class="badge badge-primary badge-sm font-mono font-bold"
        >
          01 / 0{initialNodes.length}
        </span>
        <span
          data-arch-layer
          class="badge badge-ghost badge-sm font-mono uppercase text-[11px]"
        >
          {initialNode.layer}
        </span>
        <h4
          data-arch-node-title
          class="text-base md:text-lg font-bold text-base-content"
        >
          {initialNode.title}
        </h4>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono">
        <span data-arch-tech class="text-base-content/70">
          {initialNode.tech}
        </span>
        <span aria-hidden="true" class="opacity-40">
          ·
        </span>
        <span
          data-arch-telemetry
          class="text-primary font-semibold"
          title={c.archFlowTelemetry}
        >
          {initialNode.telemetry}
        </span>
      </div>
    </div>

    <p data-arch-summary class="text-sm text-base-content/85 leading-relaxed">
      {initialNode.summary}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
      <div class="rounded-lg border border-base-content/10 bg-base-200/70 p-3 space-y-1.5">
        <div class="text-[11px] font-mono uppercase tracking-wider text-base-content/60">
          {c.archFlowContract}
        </div>
        <code
          data-arch-contract
          class="block text-xs font-mono text-primary break-words"
        >
          {initialNode.contract}
        </code>
      </div>

      <div class="rounded-lg border border-base-content/10 bg-base-200/70 p-3 space-y-1.5">
        <div class="text-[11px] font-mono uppercase tracking-wider text-base-content/60">
          {c.archFlowInvariant}
        </div>
        <p
          data-arch-invariant
          class="text-xs text-base-content/85 leading-relaxed"
        >
          {initialNode.invariant}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";
  import { initArchitectureFlows } from "../../scripts/architecture-flow";

  onPageLoad((signal) => {
    initArchitectureFlows(signal);
  });
</script>
