---
import {
  useTranslations,
  getSkillsForLang,
  getProjectsForLang,
} from "../../i18n/utils";
import { featureCopy } from "../../i18n/features";
import { buildSkillsTopology } from "../../data/skills-topology";
import SectionHeading from "../ui/SectionHeading.astro";
import SkillIcon from "../ui/SkillIcon.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);
const c = featureCopy(lang);
const skillsCategories = getSkillsForLang(lang);
const topology = buildSkillsTopology(
  lang,
  skillsCategories,
  getProjectsForLang(lang),
);
const nodeById = new Map(topology.nodes.map((node) => [node.id, node]));
const initialNode = topology.nodes[0];
const initialConnections = new Set(initialNode.connections);
const categoryLabels: Record<string, string> = {
  frontend: t("projects.frontend"),
  backend: t("projects.backend"),
  fullstack: t("projects.fullstack"),
  scientific: t("projects.scientific"),
  ai: t("projects.ai"),
};

// Authentic astronomical constellations with real celestial geometries and lore
interface ConstellationData {
  latin: string;
  alpha: string;
  meaning: Record<string, string>;
  history: Record<string, string>;
  stars: Array<[number, number]>;
  lines: Array<[number, number]>;
  anchorIndex: number;
}

const CONSTELLATIONS: Record<string, ConstellationData> = {
  languages: {
    latin: "CYGNUS",
    alpha: "Deneb",
    meaning: {
      es: "Cruz del Norte",
      en: "Northern Cross",
      de: "Kreuz des Nordens",
      ja: "北十字・白鳥座",
      ru: "Северный Крест",
    },
    history: {
      es: "Faro milenario en la Vía Láctea con Deneb. Simboliza los lenguajes que estructuran la navegación del código.",
      en: "Millenary Milky Way beacon led by Deneb. Symbolizes languages that structure codebase navigation.",
      de: "Jahrtausendealter Wegweiser der Milchstraße mit Deneb. Symbolisiert Sprachen, die die Codenavigation strukturieren.",
      ja: "デネブと共に天の川を導く道標。コードの航海を構造化する言語を象徴。",
      ru: "Вековой ориентир Млечного Пути с Денебом. Символизирует языки, структурирующие код.",
    },
    stars: [
      [112, 18], // 0: Deneb (Tail)
      [76, 38], // 1: Sadr (Center)
      [34, 60], // 2: Albireo (Head)
      [98, 62], // 3: Gienah (Left Wing)
      [54, 16], // 4: Rukhba (Right Wing)
    ],
    lines: [
      [0, 1],
      [1, 2],
      [4, 1],
      [1, 3],
    ],
    anchorIndex: 0,
  },
  frontend: {
    latin: "LYRA",
    alpha: "Vega",
    meaning: {
      es: "La Lira Celeste",
      en: "Celestial Lyre",
      de: "Himmlische Leier",
      ja: "こと座・竪琴",
      ru: "Небесная Лира",
    },
    history: {
      es: "Porta a Vega, la primera estrella fotografiada en 1850. Simboliza la armonía visual y sensorial del Frontend.",
