      [0, 1],
      [0, 2],
      [1, 4],
      [2, 3],
      [3, 4],
      [2, 5],
      [4, 6],
      [5, 6],
    ],
    anchorIndex: 3,
  },
  security: {
    latin: "DRACO",
    alpha: "Eltanin",
    meaning: {
      es: "El Guardián Insomne",
      en: "The Vigilant Dragon",
      de: "Wachsamer Drache",
      ja: "りゅう座・守護星",
      ru: "Дракон-Страж",
    },
    history: {
      es: "Guardián milenario que envuelve el polo norte celeste. Simboliza la defensa perimetral y monitoreo 24/7 de Seguridad.",
      en: "Sleepless dragon encircling the north celestial pole. Symbolizes 24/7 perimeter defense and vigilance.",
      de: "Schlafloser Wächter um den Himmelsnordpol. Symbolisiert 24/7-Perimeterschutz und Sicherheit.",
      ja: "天の北極を巡る不眠の守護竜。境界防御と継続的セキュリティ監視を象徴。",
      ru: "Неусыпный страж, обвивающий северный полюс неба. Символизирует защиту периметра 24/7.",
    },
    stars: [
      [120, 18], // 0: Eltanin (Head)
      [104, 14], // 1: Rastaban
      [98, 28], // 2: Grumium
      [116, 32], // 3: Kuma
      [80, 26], // 4: Nodus II
      [62, 42], // 5: Tyl
      [42, 36], // 6: Aldhibah
      [22, 58], // 7: Thuban
    ],
    lines: [
      [0, 1],
      [1, 2],
      [2, 3],
      [3, 0],
      [2, 4],
      [4, 5],
      [5, 6],
      [6, 7],
    ],
    anchorIndex: 0,
  },
  ai: {
    latin: "PEGASUS",
    alpha: "51 Pegasi",
    meaning: {
      es: "El Cuadrante Alado",
      en: "The Winged Steed",
      de: "Das geflügelte Ross",
      ja: "ペガスス座・大四辺形",
      ru: "Крылатый Пегас",
    },
    history: {
      es: "Hogar del primer exoplaneta descubierto (51 Pegasi). Simboliza los horizontes cognitivos de la Inteligencia Artificial.",
