---

<section
  id="skills"
  data-skills-root
  data-topology={JSON.stringify(topology)}
  data-categories={JSON.stringify(categoryLabels)}
  data-all-skills-label={c.topoAllDomainSkills}
  class="py-16 md:py-24 max-w-6xl mx-auto px-4 md:px-8 relative"
>
  <SectionHeading subtitle={t("skills.subtitle")} title={t("skills.title")} />

  <!-- View Switcher: Category Grid vs Systems Topology -->
  <div
    class="flex flex-wrap items-center justify-between gap-3 mb-8"
    role="group"
    aria-label={t("skills.title")}
  >
    <div class="inline-flex items-center gap-1.5 p-1 rounded-full bg-base-200/75 border border-base-content/10">
      <button
        type="button"
        data-skills-view-btn="grid"
        aria-pressed="true"
        class="px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border bg-primary text-primary-content border-primary shadow-sm transition-all cursor-pointer"
      >
        {t("skills.viewGrid")}
      </button>
      <button
        type="button"
        data-skills-view-btn="topology"
        aria-pressed="false"
        class="px-3.5 py-1.5 rounded-full text-xs font-mono font-medium border bg-base-200/70 text-base-content/80 border-base-content/15 hover:border-primary/40 transition-all cursor-pointer"
      >
        {t("skills.viewTopology")}
      </button>
    </div>
  </div>

  <!-- Monochromatic Celestial Constellation Sector Grid -->
  <div
    id="skills-grid-panel"
    data-skills-panel="grid"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
  >
    {skillsCategories.map((category) => {
      const constellation =
        CONSTELLATIONS[category.id] || CONSTELLATIONS.languages;
      const anchorStar = constellation.stars[constellation.anchorIndex];

      return (
        <div
          id={`skills-${category.id}`}
          tabindex={-1}
          data-spotlight="true"
          class="skill-card scroll-mt-24 group relative card bg-base-200/85 md:bg-base-200/45 md:backdrop-blur-md border border-base-content/10 p-6 rounded-2xl transition-all duration-500 hover:border-base-content/30 hover:-translate-y-1 overflow-hidden flex flex-col justify-between"
        >
          {/* Ambient Starlight Glow on Hover */}
          <div
            class="absolute -top-12 -right-12 w-44 h-44 rounded-full pointer-events-none opacity-20 group-hover:opacity-65 transition-opacity duration-500 blur-2xl bg-base-content/10"
            aria-hidden="true"
          />

          {/* Real Unique Astronomical Constellation SVG in Card Backdrop */}
          <svg
            class="absolute top-3 right-3 w-32 h-18 text-base-content pointer-events-none select-none overflow-visible opacity-50 group-hover:opacity-95 transition-opacity duration-500"
            viewBox="0 0 140 80"
            fill="none"
            aria-hidden="true"
          >
            {/* Constellation Filament Lines */}
            {constellation.lines.map(([i1, i2]) => {
              const p1 = constellation.stars[i1];
              const p2 = constellation.stars[i2];
              return (
                <line
                  x1={p1[0]}
                  y1={p1[1]}
                  x2={p2[0]}
                  y2={p2[1]}
                  stroke="currentColor"
                  stroke-width="0.75"
                  stroke-dasharray="2 2"
                  class="opacity-45 group-hover:opacity-90 transition-opacity duration-500"
                />
              );
            })}

            {/* Gravitational Ripple Wave around Principal Anchor Star */}
            <circle
              cx={anchorStar[0]}
              cy={anchorStar[1]}
              r="3"
              stroke="currentColor"
              stroke-width="0.6"
              class="sector-ripple opacity-0 group-hover:opacity-100"
            />

            {/* Constellation Stars (Monochromatic Real Starlight) */}
            {constellation.stars.map(([cx, cy], idx) => {
              const isAnchor = idx === constellation.anchorIndex;
              return (
                <circle
                  cx={cx}
                  cy={cy}
                  r={isAnchor ? "2.2" : "1.4"}
                  fill="currentColor"
                  class={isAnchor ? "opacity-95" : "opacity-60"}
                />
              );
            })}
          </svg>

          <div>
            {/* Card Header with Icon & Name (right space reserved for unobstructed constellation) */}
            <div class="flex items-start gap-3.5 pr-28 mb-4 relative z-10">
              <div class="p-3 bg-base-300/80 border border-base-content/10 text-primary rounded-xl flex items-center justify-center shrink-0 group-hover:scale-105 transition-all duration-300 shadow-xs">
                <SkillIcon name={category.icon} class="w-6 h-6" />
              </div>
              <div class="space-y-1 min-w-0">
                <h3 class="font-bold text-sm md:text-base text-base-content leading-tight group-hover:text-primary transition-colors duration-300">
                  {category.name}
                </h3>
                {category.description && (
                  <p class="text-xs text-base-content/80 leading-normal font-medium">
                    {category.description}
                  </p>
                )}
              </div>
            </div>

            {/* Single Unified Astronomical Constellation Reference Bar */}
            <div
              class="my-3 pt-2.5 border-t border-base-content/10 flex items-center gap-2 text-[11px] font-mono text-base-content/85 relative z-10 cursor-help"
              title={`${constellation.latin}: ${constellation.history[lang] || constellation.history.en}`}
            >
              <span class="text-primary text-[10px] leading-none shrink-0">
                ✦
              </span>
              <span class="font-bold tracking-wider text-base-content/90 shrink-0">
                {constellation.latin}
              </span>
              <span class="text-base-content/40 shrink-0">·</span>
              <span class="truncate text-base-content/75">
                {constellation.meaning[lang] || constellation.meaning.en}
              </span>
            </div>
          </div>

          {/* Skill Items Badges */}
          <div class="flex flex-wrap gap-2 mt-auto relative z-10">
            {category.items.map((item) => (
              <a
                href={`/${lang}/search/?q=${encodeURIComponent(item)}&evidence=1`}
                rel="nofollow"
                class="badge badge-xs font-mono bg-base-300/60 border border-base-content/10 text-base-content/85 hover:border-base-content/40 hover:text-primary transition-all duration-200 py-2 px-2.5"
              >
                {item}
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Interactive Graph View -->
  <div
    id="skills-topology-panel"
    data-skills-panel="topology"
    hidden
    class="space-y-6"
  >
    <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] gap-6 items-stretch">
      <!-- Left: Orbital Systems Graph (SVG) + Compact Quick Pills -->
      <div class="rounded-2xl border border-base-content/12 bg-base-200/60 md:bg-base-200/45 md:backdrop-blur-md p-4 md:p-5 space-y-4 flex flex-col justify-between">
        <div class="relative w-full overflow-hidden rounded-xl border border-base-content/10 bg-base-100/40">
          <svg
            class="w-full h-auto block select-none"
            viewBox="0 0 640 600"
            role="img"
            aria-label={t("skills.viewTopology")}
          >
            <!-- Background Orbital Field Rings -->
            <g class="pointer-events-none text-base-content" aria-hidden="true">
              <circle
                cx="320"
                cy="290"
                r="115"
                fill="none"
                stroke="currentColor"
                stroke-opacity="0.08"
                stroke-width="1"
                stroke-dasharray="3 5"
              ></circle>
              <circle
                cx="320"
                cy="290"
                r="205"
                fill="none"
                stroke="currentColor"
                stroke-opacity="0.06"
                stroke-width="1"
                stroke-dasharray="4 6"
              ></circle>
              <circle
                cx="320"
                cy="290"
                r="275"
                fill="none"
                stroke="currentColor"
                stroke-opacity="0.05"
                stroke-width="1"
              ></circle>
            </g>

            <!-- Dependency Conduit Edges -->
            <g>
              {topology.edges.map((edge) => {
                const n1 = nodeById.get(edge.from);
                const n2 = nodeById.get(edge.to);
                if (!n1 || !n2) return null;
                const active =
                  edge.from === initialNode.id || edge.to === initialNode.id;
                return (
                  <line
                    x1={n1.x}
                    y1={n1.y}
                    x2={n2.x}
                    y2={n2.y}
                    data-topo-edge
                    data-from={edge.from}
                    data-to={edge.to}
                    data-active={active ? "true" : "false"}
                    class="topo-edge"
                  />
                );
              })}
            </g>

            <!-- Interactive Subsystem Nodes -->
            <g>
              {topology.nodes.map((node) => {
                const isActive = node.id === initialNode.id;
                const isConnected = initialConnections.has(node.id);
                const state = isActive
                  ? "active"
                  : isConnected
                    ? "connected"
                    : "dimmed";
                return (
                  <g
                    role="button"
                    tabindex="0"
                    data-topo-node={node.id}
                    data-state={state}
                    aria-current={isActive ? "true" : "false"}
                    aria-label={`${node.name} (${node.constellation})`}
                    class="topo-node cursor-pointer focus:outline-none"
                  >
                    <circle
                      cx={node.x}
                      cy={node.y}
                      r="54"
                      class="topo-node-halo"
                    />
                    <circle
                      cx={node.x}
                      cy={node.y}
                      r="42"
                      class="topo-node-core"
                    />
                    <text
                      x={node.x}
                      y={node.y - 4}
                      text-anchor="middle"
                      class="topo-node-count font-mono text-[20px] font-extrabold"
                    >
                      {node.items.length}
                    </text>
                    <text
                      x={node.x}
                      y={node.y + 14}
                      text-anchor="middle"
                      class="topo-node-constellation font-mono text-[10px] font-semibold tracking-wider uppercase"
                    >
                      {node.constellation}
                    </text>
                    <rect
                      x={node.x - 86}
                      y={node.y + 49}
                      width="172"
                      height="24"
                      rx="12"
                      class="topo-node-label-bg"
                    />
                    <text
                      x={node.x}
                      y={node.y + 65}
                      text-anchor="middle"
                      class="topo-node-label font-sans text-[13.5px] font-bold"
                    >
                      {node.name}
                    </text>
                  </g>
                );
              })}
            </g>
          </svg>
        </div>

        <!-- Touch / Quick Domain Pills -->
        <div class="flex flex-wrap gap-1.5 pt-1">
          {topology.nodes.map((node) => {
            const isActive = node.id === initialNode.id;
            const isConnected = initialConnections.has(node.id);
            return (
              <button
                type="button"
                data-topo-pill={node.id}
                data-state={
                  isActive ? "active" : isConnected ? "connected" : "idle"
                }
                aria-pressed={isActive ? "true" : "false"}
                class:list={[
                  "px-2.5 py-1 rounded-full text-[11px] font-mono border transition-colors cursor-pointer",
                  isActive
                    ? "bg-primary text-primary-content border-primary"
                    : isConnected
                      ? "bg-base-100/80 border-primary/45 text-base-content"
                      : "bg-base-100/80 border-base-content/15 text-base-content/80 hover:border-primary/40",
                ]}
              >
                {node.name}
              </button>
            );
          })}
        </div>
      </div>

      <!-- Right: Live Subsystem & Project Evidence Inspector -->
      <aside
        data-topo-inspector
        role="region"
        aria-live="polite"
        class="rounded-2xl border border-base-content/15 bg-base-200/75 md:bg-base-200/55 md:backdrop-blur-md p-5 space-y-5"
      >
        <div class="space-y-2 border-b border-base-content/10 pb-4">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-mono uppercase tracking-wider text-primary font-semibold">
              {c.topoActiveDomain}
            </span>
            <span
              data-topo-constellation
              class="badge badge-sm badge-outline font-mono text-[10px] border-primary/40"
            >
              {initialNode.constellation} · ★ {initialNode.alpha}
            </span>
          </div>
          <h3 data-topo-title class="text-xl font-bold text-base-content">
            {initialNode.name}
          </h3>
          <p
            data-topo-desc
            class="text-xs text-base-content/75 leading-relaxed"
          >
            {initialNode.description}
          </p>
          <p
            data-topo-role
            class="text-xs md:text-sm text-base-content/90 leading-relaxed pt-1"
          >
            {initialNode.roleNote}
          </p>
        </div>

        <!-- Skills Chips & Search Evidence Action -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-mono uppercase tracking-wider text-base-content/60">
              {t("experience.technologies")}
            </span>
            <a
              data-topo-evidence-link
              href={`/${lang}/search/?q=${encodeURIComponent(initialNode.name)}&evidence=1`}
              rel="nofollow"
              class="text-[11px] font-mono text-primary hover:underline"
            >
              {c.topoExploreEvidence} ↗
            </a>
          </div>
          <div data-topo-skills class="flex flex-wrap gap-1.5">
            <button
              type="button"
              data-skill-filter=""
              aria-pressed="true"
              class="px-2.5 py-1 rounded-full text-[11px] font-mono border border-primary bg-primary text-primary-content font-semibold cursor-pointer"
            >
              {c.topoAllDomainSkills}
            </button>
            {initialNode.items.map((item) => (
              <button
                type="button"
                data-skill-filter={item}
                aria-pressed="false"
                class="px-2.5 py-1 rounded-full text-[11px] font-mono border border-base-content/15 bg-base-200/70 text-base-content/85 hover:border-primary/45 cursor-pointer"
              >
                {item}
              </button>
            ))}
          </div>
        </div>

        <!-- Coupled Domains Navigation -->
        <div class="space-y-2">
          <span class="block text-[11px] font-mono uppercase tracking-wider text-base-content/60">
            {c.topoConnections}
          </span>
          <div data-topo-connections class="flex flex-wrap gap-1.5">
            {initialNode.connections.map((connId) => {
              const neighbor = nodeById.get(connId);
              if (!neighbor) return null;
              return (
                <button
                  type="button"
                  data-topo-jump={neighbor.id}
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono border border-base-content/15 bg-base-200/70 text-base-content/85 hover:border-primary/50 hover:text-primary cursor-pointer"
                >
                  <span class="text-primary text-[10px]" aria-hidden="true">
                    ✦
                  </span>
                  <span>{neighbor.name}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Verified Portfolio Projects -->
        <div class="space-y-2.5 pt-2 border-t border-base-content/10">
          <span class="block text-[11px] font-mono uppercase tracking-wider text-base-content/60">
            {c.topoVerifiedProjects}
          </span>
          <div data-topo-projects class="space-y-2">
            {initialNode.projects.map((project) => (
              <a
                href={project.url}
                data-topo-project-card={project.id}
                class="group block rounded-xl border border-base-content/12 bg-base-200/60 hover:border-primary/45 hover:bg-base-100/90 p-3 transition-all"
              >
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="badge badge-xs badge-outline border-primary/40 text-primary font-mono">
                    {categoryLabels[project.category] || project.category}
                  </span>
                  <span
                    aria-hidden="true"
                    class="text-xs font-mono opacity-55 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all"
                  >
                    →
                  </span>
                </div>
                <div class="text-xs md:text-sm font-semibold text-base-content group-hover:text-primary transition-colors leading-snug mb-2">
                  {project.title}
                </div>
                <div class="flex flex-wrap gap-1">
                  {project.matchedSkills.map((matched) => (
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-base-300/75 text-base-content/75">
                      {matched}
                    </span>
                  ))}
                </div>
              </a>
            ))}
          </div>
          <p
            data-topo-empty
            hidden
            class="text-xs font-mono text-base-content/65"
          >
            {c.empty}
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from "../../scripts/page-lifecycle";
  import { initSkillsTopology } from "../../scripts/skills-topology";

  onPageLoad((signal) => {
    initSkillsTopology(signal);
  });
</script>

