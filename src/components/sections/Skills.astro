      de: "Heimat des ersten entdeckten Exoplaneten (51 Pegasi). Symbolisiert neue kognitive Horizonte der KI.",
      ja: "人類初の系外惑星（51ペガスス）が発見された地。AIと自律型エージェントの新たな地平を象徴。",
      ru: "Дом первой открытой экзопланеты (51 Пегаса). Символизирует автономный когнитивный ИИ.",
    },
    stars: [
      [50, 20], // 0: Scheat
      [104, 18], // 1: Alpheratz
      [44, 56], // 2: Markab
      [96, 60], // 3: Algenib
      [22, 34], // 4: Homam
      [16, 64], // 5: Enif
    ],
    lines: [
      [0, 1],
      [1, 3],
      [3, 2],
      [2, 0],
      [0, 4],
      [2, 5],
    ],
    anchorIndex: 1,
  },
  "soft-skills": {
    latin: "AQUILA",
    alpha: "Altair",
    meaning: {
      es: "El Águila de Altair",
      en: "The Navigating Eagle",
      de: "Der Adler von Altair",
      ja: "わし座・アルタイル",
      ru: "Орёл Альтаира",
    },
    history: {
      es: "Porta a Altair, faro de navegación con visión panorámica. Simboliza la comunicación asertiva, empatía y liderazgo.",
      en: "Bears Altair, navigational beacon with panoramic sight. Symbolizes assertive communication, empathy, and leadership.",
      de: "Trägt Altair, Navigationsleuchtfeuer mit Weitblick. Symbolisiert Führungskraft, Empathie und Kommunikation.",
      ja: "広大な視野を持つ航海標アルタイルを宿す。共感力、リーダーシップ、明晰なコミュニケーションを象徴。",
      ru: "Несёт Альтаир, навигационный маяк с панорамным обзором. Символизирует эмпатию, лидерство и коммуникацию.",
    },
    stars: [
      [70, 36], // 0: Altair
      [60, 22], // 1: Tarazed
      [80, 50], // 2: Alshain
      [32, 28], // 3: Left Wing
      [112, 30], // 4: Right Wing
      [70, 68], // 5: Tail
    ],
    lines: [
      [1, 0],
      [0, 2],
      [3, 0],
      [0, 4],
      [0, 5],
    ],
